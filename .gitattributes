# Mark binary files to prevent text processing issues
*.gdbtable binary
*.gdbtablx binary
*.gdbindexes binary
*.atx binary
*.spx binary
*.freelist binary
tests/fixtures/multilayer/featuredataset.gdb/* binary
tests/fixtures/multilayer/multilayer.gdb/* binary
# Also catch the gdb file (not just by extension)
tests/fixtures/multilayer/*.gdb/gdb binary
tests/fixtures/multilayer/*.gdb/timestamps binary
# The portolan-core writer tests compare these files byte for byte with LF output
tests/fixtures/core/** text eol=lf
